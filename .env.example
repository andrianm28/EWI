# --- API ---
NODE_ENV=development
PORT=4100
# Database milik ELGOS sendiri (bukan DB EliteMentor)
DATABASE_URL=postgres://ewi:ewi@localhost:5433/ewi_dev
DB_SCHEMA=ewi
# PK-07 / PD-8: di staging/prod aplikasi memakai role khusus tanpa DDL (DB_USER/DB_PASSWORD, dirakit jadi
# DATABASE_URL oleh docker-entrypoint.sh), migrasi memakai pemilik schema. Kosong = migrasi pakai user DATABASE_URL.
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=
# true = API menolak boot bila tersambung sebagai superuser (disarankan di staging/prod setelah role aplikasi dibuat)
DB_REQUIRE_NON_SUPERUSER=false
# Wajib diisi, minimal 32 karakter. Terpisah dari SESSION_SECRET EliteMentor (keputusan B22). Tidak ada fallback.
EWI_JWT_SECRET=
EWI_JWT_AUDIENCE=ewi
EWI_JWT_ISSUER=ewi-api
EWI_JWT_TTL=8h
CORS_ORIGIN=http://localhost:5174
# --- Web ---
VITE_API_BASE_URL=http://localhost:4100/api
# --- Integrasi EliteMentor (sistem terpisah, ADR 0001) ---
ELITEMENTOR_API_URL=
ELITEMENTOR_TOKEN_URL=
ELITEMENTOR_CLIENT_ID=
ELITEMENTOR_CLIENT_SECRET=
ELITEMENTOR_WEBHOOK_SECRET=
# B7: penugasan course ke EliteMentor. Biarkan false sampai kontrak FR-EM final.
ELITEMENTOR_ASSIGNMENTS_ENABLED=false

# Komponen AI teks (PK-06, lihat docs/ewi/ai-teks.md).
# stub = tiruan deterministik (bawaan di luar produksi), bedrock = Amazon Bedrock (bawaan dan wajib di produksi)
AI_PROVIDER=stub
# Bedrock (PD-2b, 19 Nov): latensi terendah yang memenuhi spek. Urutan: Jakarta ap-southeast-3 bila model tersedia
# in-region, lalu Singapura ap-southeast-1, lalu profil lintas region apac. (BEDROCK_MODEL_ID=apac.<id>).
# Profil global./us./eu. ditolak. AI_ALLOWED_REGIONS membatasi BEDROCK_REGION.
BEDROCK_REGION=ap-southeast-3
AI_ALLOWED_REGIONS=ap-southeast-3,ap-southeast-1
BEDROCK_MODEL_ID=
# Opsional: JSON additionalModelRequestFields, mis. {"thinking":{"type":"disabled"}} bila model mendukung
BEDROCK_EXTRA_FIELDS=
# Batas pertanyaan per wawancara dan batas waktu per panggilan model
AI_MAX_QUESTIONS=8
AI_TIMEOUT_MS=30000
# Harga per sejuta token (USD) untuk estimasi biaya di ai_usage_logs; kosong = biaya tidak dihitung
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
# Kredensial memakai rantai AWS SDK (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY yang sama dengan KMS dan SES)

# Dropdown organisasi di halaman login. true hanya untuk dev/staging (daftar klien jangan terbuka di produksi)
LOGIN_TENANT_PICKER=false

# Login link email (R3-2). Alamat web untuk link; kosong = origin pertama CORS_ORIGIN
APP_BASE_URL=http://localhost:5174
# log = isi email ditulis ke log (dev/staging saja), ses = Amazon SES (wajib di produksi, butuh MAIL_FROM)
MAIL_PROVIDER=log
MAIL_FROM=
MAIL_REGION=ap-southeast-3
# PK-07 / I-5: hanya kirim ke domain ini (dipisah koma, subdomain ikut). Staging (EWI_ENV=staging) tanpa isi =
# eliteacademy.id,elitery.com. Kosong di luar staging = semua domain.
MAIL_ALLOWED_DOMAINS=

# Enkripsi kolom per tenant (R2-3). local = kunci induk dari env (dev/staging di luar KMS), kms = KMS key per tenant (wajib di produksi)
ENCRYPTION_PROVIDER=local
# 32 byte, buat dengan: openssl rand -hex 32. Jangan pakai ulang antar lingkungan; kehilangan kunci = data terenkripsi tidak bisa dibaca
EWI_LOCAL_MASTER_KEY=
# KMS: key tenant dicari lewat alias alias/<prefix>-<tenantId>
KMS_KEY_ALIAS_PREFIX=elgos-tenant
KMS_REGION=ap-southeast-3

# B14 Learning Delivery: dokumentasi pelatihan (foto/video/materi). Kosong = unggah dijawab 501.
# Di server: volume di luar image, ikut cadangan, disk terenkripsi, dibersihkan saat tenant dihapus.
EWI_UPLOAD_DIR=
# Batas satu berkas dalam MB (1 sampai 200). Samakan dengan client_max_body_size nginx.
EWI_UPLOAD_MAX_MB=25
