# Salin ke /srv/elgos-<env>/.env di etavm2 (mode 600, milik elgos-deploy). JANGAN commit isinya.
# Berkas ini masuk ke container API. setup-etavm2.sh membuatnya dengan secret acak.
# Satu file per lingkungan; nilai staging dan prod harus berbeda.

# URL publik lingkungan ini (staging: https://stg-elgos.eliteacademy.id, prod: https://elgos.eliteacademy.id)
PUBLIC_URL=
# Port lokal web (dipakai Caddy): staging 8181, prod 8180
WEB_PORT=

# Password role aplikasi elgos_app (PD-8; role dibuat/diperbarui deploy.sh): openssl rand -hex 24
# Password pemilik DB (POSTGRES_PASSWORD) ada di db.env terpisah, bukan di sini.
DB_PASSWORD=
# JWT ELGOS (aturan 5 CLAUDE.md, tanpa fallback): openssl rand -hex 48
EWI_JWT_SECRET=

# Login (PK-16). Wajib di prod: email Admin ETA (pisah koma); tanpa ini tidak ada Admin ETA yang bisa masuk.
ETA_ADMIN_EMAILS=
# Jumlah proxy di depan API: Caddy (host) -> nginx (container web) = 2. Batas laju per IP memakai IP
# klien dari X-Forwarded-For. Caddy menimpa X-Forwarded-For dari klien (tanpa trusted_proxies), jadi
# tidak bisa dipalsukan. Bila nanti di-proxy Cloudflare, set trusted_proxies Cloudflare di Caddyfile.
TRUST_PROXY=2
# Staging saja, opsional: false = matikan login password (prod selalu mati, PD-10)
# AUTH_PASSWORD_LOGIN=false

# AWS (keputusan 17 Nov: KMS + SES tetap di AWS). Access key IAM user elgos-<env>-app dari
# `aws iam create-access-key --user-name elgos-<env>-app` (lihat docs/infra/vps-etavm2.md).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
KMS_KEY_ALIAS_PREFIX=          # staging: elgos-staging-tenant, prod: elgos-prod-tenant
MAIL_FROM=noreply@eliteacademy.id   # R2-5r belum final

# Integrasi EliteMentor (OAuth2 client credentials + webhook HMAC)
ELITEMENTOR_API_URL=
ELITEMENTOR_TOKEN_URL=
ELITEMENTOR_CLIENT_ID=
ELITEMENTOR_CLIENT_SECRET=
ELITEMENTOR_WEBHOOK_SECRET=

# Job pembersihan batch import (PK-15): umur batch dalam hari, bawaan 7
# IMPORT_BATCH_TTL_DAYS=7

# Batas sumber daya (default cocok untuk prod di 8 vCPU / 32 GB; staging boleh lebih kecil)
# DB_CPUS=2
# DB_MEMORY=6g
# PG_SHARED_BUFFERS=1GB
# PG_EFFECTIVE_CACHE=3GB
# API_CPUS=2
# API_MEMORY=4g
