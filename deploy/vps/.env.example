# Salin ke /srv/elgos-<env>/.env di etavm2 (mode 600, milik elgos-deploy). JANGAN commit isinya.
# Berkas ini masuk ke container API. setup-etavm2.sh membuatnya dengan secret acak.
# Satu file per lingkungan; nilai staging dan prod harus berbeda.

# URL publik lingkungan ini (staging: https://stg-elgos.eliteacademy.id, prod: https://elgos.eliteacademy.id)
PUBLIC_URL=
# Port lokal web (dipakai Caddy): staging 8181, prod 8180
WEB_PORT=

# Role aplikasi (PD-8): hanya DML di schema ewi, tanpa DDL; dibuat/diperbarui deploy.sh (ops/app-role.sql).
# Password superuser (POSTGRES_PASSWORD) dan pemilik/migrasi (DB_MIGRATION_PASSWORD, user elgos_owner)
# ada di db.env, bukan di sini, sehingga tidak masuk container API.
DB_USER=elgos_app
DB_PASSWORD=
# API menolak boot bila tersambung sebagai superuser (P1-7)
DB_REQUIRE_NON_SUPERUSER=true
# JWT ELGOS (aturan 5 CLAUDE.md, tanpa fallback): openssl rand -hex 48
EWI_JWT_SECRET=

# Login (PK-16). Wajib di prod: email Admin ETA (pisah koma); tanpa ini tidak ada Admin ETA yang bisa masuk.
ETA_ADMIN_EMAILS=
# Jumlah proxy di depan API: Caddy (host) -> nginx (container web) = 2. Batas laju per IP memakai IP
# klien dari X-Forwarded-For. Caddy menimpa X-Forwarded-For dari klien (tanpa trusted_proxies), jadi
# tidak bisa dipalsukan. Bila nanti di-proxy Cloudflare, set trusted_proxies Cloudflare di Caddyfile.
TRUST_PROXY=2
# Staging saja, opsional: false = matikan login password (prod selalu mati, PD-10)
# AUTH_PASSWORD_LOGIN=false

# AWS (keputusan 17 Nov: KMS + SES tetap di AWS). Access key IAM user elgos-<env>-app dari
# `aws iam create-access-key --user-name elgos-<env>-app` (lihat docs/infra/vps-etavm2.md).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
KMS_KEY_ALIAS_PREFIX=          # staging: elgos-staging-tenant, prod: elgos-prod-tenant
MAIL_FROM=noreply@eliteacademy.id   # R2-5r belum final

# AI teks (PK-06, PD-1 A): endpoint Bedrock ap-southeast-1. Wajib; API produksi menolak boot tanpa model.
# Keputusan user 23 Nov: Sonnet 5.5 lewat profil global (di Singapura 5.5 tidak tersedia ON_DEMAND);
# prompt bisa diproses di region AWS mana pun. Pengaturan izin lintas region aplikasi: lihat docs/ewi/ai-teks.md.
BEDROCK_REGION=ap-southeast-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5-5
# Opt-in profil global. per lingkungan (keputusan user 24 Nov). Tanpa nilai true, image yang memuat opt-in ini menolak
# boot dengan ID global. Staging (data demo) boleh true; prod hanya setelah DPIA dan teks persetujuan diperbarui legal.
AI_ALLOW_GLOBAL_PROFILE=
# Opsional, untuk estimasi biaya per panggilan (US$ per juta token)
# AI_PRICE_INPUT_PER_MTOK=
# AI_PRICE_OUTPUT_PER_MTOK=

# Integrasi EliteMentor (OAuth2 client credentials + webhook HMAC)
ELITEMENTOR_API_URL=
ELITEMENTOR_TOKEN_URL=
ELITEMENTOR_CLIENT_ID=
ELITEMENTOR_CLIENT_SECRET=
ELITEMENTOR_WEBHOOK_SECRET=
# Kirim penugasan materi ke EliteMentor (B7/B8, PR #24). Bawaan false; nyalakan setelah integrasi diuji.
ELITEMENTOR_ASSIGNMENTS_ENABLED=false

# Job pembersihan batch import (PK-15): umur batch dalam hari, bawaan 7
# IMPORT_BATCH_TTL_DAYS=7

# Suara (B19, Gemini Live via Vertex AI). Kunci dipasang dengan: sudo ops/pasang-kunci-gcp.sh <env>
# (sumber /etc/elgos/gcp-voice.json, project elgos-dev, SA elgos-voice, hanya roles/aiplatform.user).
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-voice.json
# GOOGLE_CLOUD_PROJECT=elgos-dev
# fake = tanpa GCP (dev/e2e). Staging diubah ke gemini-vertex untuk uji asap 24 Nov.
VOICE_PROVIDER=none
VOICE_MODEL=gemini-3.8-live
VOICE_LOCATION=asia-south1

# Batas sumber daya (default cocok untuk prod di 8 vCPU / 32 GB; staging boleh lebih kecil)
# DB_CPUS=2
# DB_MEMORY=6g
# PG_SHARED_BUFFERS=1GB
# PG_EFFECTIVE_CACHE=3GB
# API_CPUS=2
# API_MEMORY=4g
