# /srv/elgos-<env>/db.env (mode 600). Hanya untuk container db dan langkah migrasi/backup/restore di
# deploy.sh; tidak pernah masuk ke container API (P1-7). Dibuat acak oleh setup-etavm2.sh.
# Superuser bawaan container (elgos): hanya bootstrap role, backup, restore.
POSTGRES_PASSWORD=
# Pemilik schema ewi (elgos_owner, bukan superuser): migrasi. User-nya tetap (DB_MIGRATION_USER=elgos_owner),
# dibuat/diperbarui deploy.sh lewat ops/app-role.sql.
DB_MIGRATION_PASSWORD=
