# Salin ke .env (jangan di-commit). Bangkitkan nilai acak: openssl rand -base64 48 | tr -d '/+='
POSTGRES_PASSWORD=
EWI_JWT_SECRET=
# URL publik: dipakai CORS dan health check publik pipeline (kosong = cek publik dilewati).
PUBLIC_URL=https://dev-elgos.eliteacademy.id
# Password user seed (hr@demo.test, learner@demo.test, ...). Wajib diisi bila memakai pipeline:
# tanpa nilai ini pipeline melewati seed agar password tidak berubah acak setiap deploy.
DEV_SEED_PASSWORD=
WEB_PORT=8080
# Dev/staging saja: tampilkan pilihan organisasi di halaman login
LOGIN_TENANT_PICKER=true
# Kunci enkripsi lokal (wajib sejak PR #2): openssl rand -hex 32. Unik per lingkungan; HILANG = data
# terenkripsi tidak terbaca. Simpan cadangannya di tempat aman.
EWI_LOCAL_MASTER_KEY=
# URL dasar untuk tautan login via email
APP_BASE_URL=https://dev-elgos.eliteacademy.id
# log = tautan login ditulis ke log container (dev). Jangan set NODE_ENV=production di dev.
MAIL_PROVIDER=log
# Opsional: integrasi EliteMentor
ELITEMENTOR_API_URL=
ELITEMENTOR_TOKEN_URL=
ELITEMENTOR_CLIENT_ID=
ELITEMENTOR_CLIENT_SECRET=
ELITEMENTOR_WEBHOOK_SECRET=
