# Salin ke .env (jangan di-commit). Bangkitkan nilai acak: openssl rand -base64 48 | tr -d '/+='
POSTGRES_PASSWORD=
EWI_JWT_SECRET=
# Kunci induk lokal pengganti KMS per tenant (R2-3), 32 byte: openssl rand -hex 32
EWI_LOCAL_MASTER_KEY=
# URL publik (isi setelah tunnel jalan; dipakai CORS). Web memanggil /api relatif, jadi boleh kosong.
PUBLIC_URL=
# quick = URL trycloudflare acak; named = URL tetap (butuh CLOUDFLARE_TUNNEL_TOKEN)
COMPOSE_PROFILES=quick
CLOUDFLARE_TUNNEL_TOKEN=
# Opsional: password user seed (hr@demo.test, learner@demo.test); kosong = acak dan dicetak
DEV_SEED_PASSWORD=
WEB_PORT=8080
# Opsional: integrasi EliteMentor
ELITEMENTOR_API_URL=
ELITEMENTOR_TOKEN_URL=
ELITEMENTOR_CLIENT_ID=
ELITEMENTOR_CLIENT_SECRET=
ELITEMENTOR_WEBHOOK_SECRET=
