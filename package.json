{
  "name": "ewi-platform",
  "private": true,
  "description": "Elite Learning & Growth Operating System (ELGOS): API dan web app",
  "workspaces": ["apps/api", "apps/web"],
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
